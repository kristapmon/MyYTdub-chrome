{
  "manifest_version": 3,
  "name": "MyYTdub",
  "version": "0.1.0",
  "description": "Real-time Latvian (or other-language) dub for any browser tab via OpenAI realtime translation.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyYTdub"
  }
}
